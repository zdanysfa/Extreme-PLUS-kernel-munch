+/*
+ * cam_cci_dev.c closes VIDIOC_MSM_CCI_CFG on the subdev ioctl (userspace
+ * could reach it), so in-kernel sensor I/O calls the CCI core directly.
+ */
+static int32_t cam_cci_cfg(struct v4l2_subdev *sd,
+	struct cam_cci_ctrl *cci_ctrl)
+{
+	if (!sd)
